# Local-development Compose values. Do not use this file for production.
NODE_ENV=development
POSTGRES_DB=tms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432

API_PORT=3001
WEB_PORT=5173
# Browser-visible API URL baked into the web image at build time.
TMS_API_BASE_URL=http://localhost:3001/api
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Optional dedicated stable key (32+ characters) for encrypted admission SMS jobs.
# If unset, BETTER_AUTH_SECRET is used. Do not rotate the selected key with pending jobs.
ADMISSION_DELIVERY_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# Provisioning surface. Production additionally requires the explicit,
# temporary acknowledgement below.
PLATFORM_ADMIN_ENABLED=false
PLATFORM_ADMIN_PRODUCTION_ACK=
SMS_PROVIDER=MOCK
# Production: set SMS_PROVIDER=AAKASH and provide the token, or use DISABLED.
AAKASH_SMS_AUTH_TOKEN=
NEPALPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_2FA=false

CONNECTIPS_ENABLED=false
CONNECTIPS_ENVIRONMENT=STAGING
CONNECTIPS_PUBLIC_BASE_URL=https://api.staging.sanskardipshikshalaya.com.np
PAYMENT_FRONTEND_BASE_URL=https://staging.tms.sanskardipshikshalaya.com.np
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_PFX_BASE64=
CONNECTIPS_PFX_PASSWORD=
CONNECTIPS_VALIDATE_PASSWORD=
CONNECTIPS_GATEWAY_URL=https://uat.connectips.com/connectipswebgw/loginpage
CONNECTIPS_VALIDATE_URL=https://uat.connectips.com/connectipswebws/api/creditor/validatetxn

# Manual QR checkout presentation. Configure independently per environment.
STATIC_PAYMENT_QR_ENABLED=false
STATIC_PAYMENT_QR_IMAGE_URL=
STATIC_PAYMENT_ACCOUNT_NAME=
STATIC_PAYMENT_ACCOUNT_NUMBER=
STATIC_PAYMENT_BANK_NAME=
STATIC_PAYMENT_INSTRUCTIONS=

# Private Cloudflare R2 payment-proof storage. Configure all four together.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tms-private-media

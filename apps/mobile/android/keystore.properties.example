# Copy to `keystore.properties` (same directory, NEVER committed) and fill in
# real values, OR export the TMS_KEYSTORE_* env vars instead (CI path).
# See apps/mobile/README.md ("Release identity & signing").
storeFile=release.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=tms-release
keyPassword=REPLACE_WITH_KEY_PASSWORD

+import assert from 'node:assert/strict';
+import { createPushRecipientPolicy } from './push-recipient-policy';
+assert.equal(createPushRecipientPolicy({})('t', 'u', 'T', 'B'), false);
+assert.equal(createPushRecipientPolicy({PUSH_DELIVERY_MODE:'DISABLED'})('t', 'u', 'T', 'B'), false);
+assert.throws(() => createPushRecipientPolicy({PUSH_DELIVERY_MODE:'unexpected'}));
+for (const value of ['not-json', '{}', '[]', '[{}]', '[{"tenantId":"t","userId":""}]']) {
+  assert.throws(() => createPushRecipientPolicy({PUSH_DELIVERY_MODE:'ALLOWLIST', PUSH_ALLOWED_RECIPIENTS:value}));
+}
+const policy = createPushRecipientPolicy({PUSH_DELIVERY_MODE:'ALLOWLIST',
+  PUSH_TEST_TITLE:'T', PUSH_TEST_BODY:'B',
+  PUSH_ALLOWED_RECIPIENTS:JSON.stringify([{tenantId:'t',userId:'u'}])});
+assert.equal(policy('t','u','T','B'),true);
+assert.equal(policy('other','u','T','B'),false);
+assert.equal(policy('t','other','T','B'),false);
+assert.equal(createPushRecipientPolicy({PUSH_DELIVERY_MODE:'ALL'})('t','u','T','B'),true);
+console.log('PASS closed default, explicit modes, malformed rejection, exact tenant/recipient scope');
+
+assert.equal(policy('t','u','Normal workflow','B'),false);
+assert.equal(policy('t','u','T','Unapproved content'),false);
+
+assert.throws(() => createPushRecipientPolicy({PUSH_DELIVERY_MODE:'ALLOWLIST', PUSH_ALLOWED_RECIPIENTS:JSON.stringify([{tenantId:'t',userId:'u'}])}));
diff --git a/services/api/src/services/push-recipient-policy.ts b/services/api/src/services/push-recipient-policy.ts
new file mode 100644
index 0000000..f7c0950
--- /dev/null
+++ b/services/api/src/services/push-recipient-policy.ts
@@ -0,0 +1,24 @@
+/** Delivery is closed until the operator selects an explicit audience. */
+export type PushRecipientPolicy = (tenantId: string, userId: string, title: string, body: string) => boolean;
+
+export function createPushRecipientPolicy(env: NodeJS.ProcessEnv): PushRecipientPolicy {
+  const mode = (env.PUSH_DELIVERY_MODE || 'DISABLED').toUpperCase();
+  if (mode === 'DISABLED') return () => false;
+  if (mode === 'ALL') return () => true;
+  if (mode !== 'ALLOWLIST') throw new Error('PUSH_DELIVERY_MODE must be DISABLED, ALLOWLIST or ALL.');
+  let entries: unknown;
+  try { entries = JSON.parse(env.PUSH_ALLOWED_RECIPIENTS || '[]'); }
+  catch { throw new Error('PUSH_ALLOWED_RECIPIENTS must be a JSON recipient list.'); }
+  if (!Array.isArray(entries) || entries.length === 0 || entries.some(entry =>
+    !entry || typeof entry !== 'object' ||
+    typeof entry.tenantId !== 'string' || !entry.tenantId.trim() ||
+    typeof entry.userId !== 'string' || !entry.userId.trim())) {
+    throw new Error('PUSH_ALLOWED_RECIPIENTS must contain explicit tenantId/userId pairs.');
+  }
+  if (!env.PUSH_TEST_TITLE?.trim() || !env.PUSH_TEST_BODY?.trim()) {
+    throw new Error('ALLOWLIST requires exact PUSH_TEST_TITLE and PUSH_TEST_BODY.');
+  }
+  const allowed = new Set(entries.map(entry => JSON.stringify([entry.tenantId, entry.userId])));
+  return (tenantId, userId, title, body) => allowed.has(JSON.stringify([tenantId, userId])) &&
+    title === env.PUSH_TEST_TITLE && body === env.PUSH_TEST_BODY;
+}

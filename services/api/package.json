{
  "name": "@tms/api",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "sms:test": "npm run build && node dist/scripts/send-sms-test.js",
    "sms:fixture-test": "npm run build && node dist/scripts/run-sms-invoice-fixture.js",
    "sms:fixture-retry": "npm run build && node dist/scripts/retry-sms-invoice-fixture.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:petty-cash": "ts-node src/routes/petty-cash.test.ts",
    "test:account-contact": "ts-node src/routes/account-contact.test.ts",
    "test:account-profile": "ts-node src/routes/account-profile.test.ts",
    "test:user-management-access": "ts-node src/routes/user-management-access.test.ts",
    "recovery:mobile": "ts-node src/scripts/mobile-recovery.ts",
    "test:mobile-recovery": "ts-node src/services/mobile-recovery.test.ts && ts-node src/routes/mobile-recovery.test.ts",
    "test:access": "ts-node src/utils/access-control.test.ts",
    "test:calendar": "ts-node src/services/calendar-access.test.ts && ts-node src/routes/calendar-permissions.test.ts",
    "test:billing": "ts-node src/utils/billing-rules.test.ts",
    "test:sms": "ts-node src/utils/sms.test.ts",
    "test:auth-sms": "ts-node src/utils/delivery.test.ts && ts-node src/routes/auth-sms.test.ts",
    "test:connectips": "ts-node src/utils/connectips.test.ts",
    "test:connectips-reconciliation": "ts-node src/utils/connectips-reconciliation.test.ts",
    "connectips:reconcile": "npm run build && node dist/scripts/reconcile-connectips.js",
    "test:runtime-config": "ts-node src/utils/runtime-config.test.ts",
    "test:request-validation": "ts-node src/utils/request-validation.test.ts",
    "test:schedule": "ts-node src/utils/schedule.test.ts",
    "test:nepali": "ts-node src/utils/nepali.test.ts",
    "test:timetable": "ts-node src/services/timetable-service.test.ts",
    "test:financial-intelligence": "ts-node src/utils/financial-intelligence.test.ts",
    "test:payroll": "ts-node src/services/payroll-service.test.ts",
    "test:route-auth": "ts-node src/routes/route-authentication.test.ts",
    "test:attendance": "ts-node src/routes/attendance.test.ts",
    "test:notifications": "ts-node src/routes/notifications.test.ts && ts-node src/services/push-notification.test.ts",
    "test:phase-one-security": "ts-node src/routes/phase-one-security.test.ts",
    "test:phase-two-billing": "ts-node src/routes/phase-two-billing.test.ts",
    "test:phase-three-workflows": "ts-node src/routes/phase-three-workflows.test.ts",
    "test:phase-four-branch-payment": "ts-node src/services/branch-payment-settings.test.ts && ts-node src/routes/branch-payment-settings.test.ts && ts-node src/routes/payment-settings-access.test.ts && ts-node src/services/payment-settings-verification.test.ts && ts-node src/services/object-storage.test.ts",
    "test:private-media": "ts-node src/services/object-storage.test.ts && ts-node src/services/student-photo.test.ts",
    "test:certificates": "ts-node src/services/certificate-renderer.test.ts",
    "admissions:recover": "ts-node src/scripts/recover-admission-deliveries.ts",
    "test:tenant-admin:integration": "ts-node src/integration/tenant-admin.integration.test.ts"
  },
  "prisma": {
    "seed": "node prisma/seed-runner.cjs"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "ts,json,env"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@prisma/client": "^5.0.0",
    "@tms/types": "*",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.23",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "nepali-date-library": "^1.1.11",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.11",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^2.0.22",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CourseType {
  REGULAR
  MUSIC
  SHORT_TERM
  LONG_TERM
  PERSONALIZED
}

enum SessionStatus {
  PRESENT_CONFIRMED
  PRESENT_UPDATE_PENDING
  PARTIAL_PRESENCE
  UNSCHEDULED_PRESENCE
  ABSENT
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  BLOCKED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  BLOCKED_OVERRIDE
}

enum InvoiceType {
  ADMISSION
  TUITION
  SUBJECT
  ACTIVITY
}

enum GradeBillingMode {
  GRADE
  SUBJECT
}

enum AdmissionStatus {
  PENDING_PAYMENT
  READY_FOR_LOGIN
  ACTIVE
}

enum PaymentProvider {
  CONNECTIPS
  NEPALPAY
  CASH
  BANK
}

enum PaymentAttemptStatus {
  PENDING
  VALIDATING
  SUCCESS
  FAILED
  INCOMPLETE
}

enum RefundPolicy {
  PRO_RATA
  FIXED_DEDUCTION
  NO_REFUND
}

enum LateFeeMode {
  FLAT
  PERCENTAGE
}

enum LeaveType {
  CASUAL
  SICK
  LONG_SICK
  EARLY_OUT
}

enum LeaveStatus {
  PENDING
  APPROVED_LEVEL1
  APPROVED_LEVEL2
  REJECTED
}

enum AppointmentStatus {
  REQUESTED
  APPROVED
  REJECTED
  ALTERNATIVE_PROPOSED
  CONFIRMED
  CANCELLED
}

enum PerformanceSignal {
  IMPROVING
  STABLE
  NEEDS_SUPPORT
}

enum PettyCashStatus {
  PENDING
  APPROVED_LEVEL1
  APPROVED_LEVEL2
  REJECTED
  RELEASED
  RECEIPT_SUBMITTED
  CLOSED
}

enum ResourceLogStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

enum AdmissionLoginRecipient {
  STUDENT
  PARENT
}

enum SocialPlatform {
  META
  TIKTOK
  LINKEDIN
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  BLOCKED
  FAILED
}

enum SocialPublishOutcome {
  PUBLISHED
  BLOCKED
  FAILED
}

// Client tenant onboarding request flow (Super Admin reviews, then manually provisions)
model MobileRecovery {
  id                String   @id @default(uuid())
  userId            String
  tenantId          String
  tokenHash         String   @unique
  newPhone          String
  oldPhone          String
  accountUpdatedAt  DateTime
  credentialHash    String
  reviewer          String
  reviewReference   String
  approvedAt        DateTime @default(now())
  expiresAt         DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  codeHash          String?
  codeExpiresAt     DateTime?
  attempts          Int      @default(0)
  sends             Int      @default(0)
  lastSentAt        DateTime?

  @@index([userId, consumedAt])
}

model RecoverySmsNotice {
  id         String   @id @default(uuid())
  recoveryId String
  recipient  String
  message    String
  acceptedAt DateTime?
  leaseUntil DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([recoveryId, recipient])
}

model TenantRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  panNumber String // Nepal 9-digit PAN/VAT
  remarks   String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1. Tenant / Institution
model Tenant {
  id                        String                   @id @default(uuid())
  name                      String
  panNumber                 String                   @unique // Nepal 9-digit PAN/VAT
  status                    UserStatus               @default(ACTIVE)
  vatRate                   Float                    @default(13)
  gracePeriodMinutes        Int                      @default(15)
  pettyCashCapNpr           Int                      @default(20000)
  refundPolicy              RefundPolicy             @default(NO_REFUND)
  lateFeeEnabled            Boolean                  @default(false)
  lateFeeMode               LateFeeMode?
  lateFeeValue              Decimal?                 @db.Decimal(12, 2)
  lateFeeGraceDays          Int                      @default(0)
  appointmentWindowHours    Int                      @default(24)
  maintenanceEscalationDays Int                      @default(3)
  leavePolicy               Json?
  performanceWeights        Json?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  branches                  Branch[]
  roles                     Role[]
  users                     User[]
  courses                   Course[]
  invoices                  Invoice[]
  leaves                    Leave[]
  pettyCash                 PettyCash[]
  pettyCashFunding          PettyCashFunding[]
  grades                    Grade[]
  // Phase 2 relations
  academicEvents            AcademicEvent[]
  certificateTemplates      CertificateTemplate[]
  vehicleRoutes             VehicleRoute[]
  expenses                  Expense[]
  payrolls                  Payroll[]
  refunds                   RefundRequest[]
  paymentAttempts           PaymentAttempt[]
  policyVersions            TenantPolicyVersion[]
  parentMessages            ParentMessage[]
  broadcasts                Broadcast[]
  appointments              Appointment[]
  studentRemarks            StudentRemark[]
  studentScores             StudentScore[]
  admissionLoginDeliveries  AdmissionLoginDelivery[]
  branchPaymentSettings     BranchPaymentSettings[]
  mediaObjects              MediaObject[]
  devicePushTokens          DevicePushToken[]
  socialMediaPosts          SocialMediaPost[]
  socialPublishAttempts     SocialPublishAttempt[]
}

// 2. Branch / Center
model Branch {
  id                 String              @id @default(uuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  name               String
  address            String
  latitude           Float
  longitude          Float
  radiusMeters       Float               @default(100.0) // Geofence radius
  gracePeriodMinutes Int                 @default(15)
  admissionFee       Int                 @default(0) // Branch-specific admission charge in NPR
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userRoles          UserRole[]
  courses            Course[]
  classes            Class[]
  leaves             Leave[]
  pettyCash          PettyCash[]
  pettyCashFunding   PettyCashFunding[]
  resourceLogs       ResourceLog[]
  maintenanceTasks   MaintenanceTask[]
  teacherAttendance  TeacherAttendance[]
  paymentSettings    BranchPaymentSettings?
  // Phase 2 relations
  academicEvents     AcademicEvent[]
  certificates       Certificate[]
  expenses           Expense[]
  invoices           Invoice[]
  paymentAttempts    PaymentAttempt[]
  mediaObjects       MediaObject[]
  payrolls           Payroll[]
}

// 3. RBAC Roles
model Role {
  id          String     @id @default(uuid())
  tenantId    String? // Null for default global system roles
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  name        String
  permissions Json // Store role capability array
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userRoles   UserRole[]
}

// 4. Core User Accounts
model User {
  id                       String                   @id @default(uuid())
  tenantId                 String
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id])
  email                    String                   @unique
  passwordHash             String
  firstName                String
  lastName                 String
  phone                    String
  securityMobile           String?
  securityMobileVerifiedAt DateTime?
  status                   UserStatus               @default(ACTIVE)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  userRoles                UserRole[]
  staffRecord              StaffRecord?
  student                  Student?
  parent                   Parent?
  leaves                   Leave[]
  teacherAttendance        TeacherAttendance[]
  teacherSessions          TeacherSession[]
  assignedClasses          Class[]                  @relation("AssignedClasses")
  sentParentMessages       ParentMessage[]          @relation("ParentMessageSender")
  receivedParentMessages   ParentMessage[]          @relation("ParentMessageReceiver")
  requestedAppointments    Appointment[]            @relation("AppointmentRequester")
  teacherAppointments      Appointment[]            @relation("AppointmentTeacher")
  authoredStudentRemarks   StudentRemark[]          @relation("StudentRemarkAuthor")
  recordedStudentScores    StudentScore[]           @relation("StudentScoreRecorder")
  admissionLoginDeliveries AdmissionLoginDelivery[] @relation("AdmissionLoginRecipientUser")
  authoredBroadcasts       Broadcast[]              @relation("BroadcastAuthor")
  devicePushTokens         DevicePushToken[]

  // Better Auth support
  name             String
  emailVerified    Boolean    @default(false)
  twoFactorEnabled Boolean    @default(false)
  image            String?
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
}

model DevicePushToken {
  id        String       @id @default(uuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token    String       @unique
  platform PushPlatform
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([tenantId, userId])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
}

// 5. User-Role-Branch Junction (Handles multiple branches per teacher/admin)
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  branchId  String? // Null means tenant-wide access
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId, branchId])
}

// 6. HR Staff Records
model StaffRecord {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  user             User                   @relation(fields: [userId], references: [id])
  joiningDate      DateTime
  designation      String
  contractType     String // FIXED, HOUR_RATE, CASUAL
  salaryStructure  Json // Hourly rates, basic monthly, etc.
  documents        Json? // Links to stored files (contract, NID, certifications)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  // Phase 2 relations
  staffDocuments   StaffDocument[]
  performanceScore StaffPerformanceScore?
  exitClearance    ExitClearance?
  payrolls         Payroll[]
}

// Grade level (Nursery, LKG, UKG, Class 1..12) — CRUD-managed per tenant.
model Grade {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  name         String
  sortOrder    Int              @default(0)
  monthlyFee   Int              @default(0) // Base monthly tuition for this grade (all subjects)
  admissionFee Int              @default(0)
  billingMode  GradeBillingMode @default(GRADE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  students     Student[]
  courses      Course[]

  @@unique([tenantId, name])
}

// 7. Student Records
model Student {
  id                  String                   @id @default(uuid())
  admissionNumber     String?                  @unique
  userId              String                   @unique
  user                User                     @relation(fields: [userId], references: [id])
  gradeId             String?
  grade               Grade?                   @relation(fields: [gradeId], references: [id])
  admissionDate       DateTime
  emergencyContact    String
  admissionRecord     Json?
  admissionStatus     AdmissionStatus          @default(PENDING_PAYMENT)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  enrollments         Enrollment[]
  studentParents      StudentParent[]
  invoices            Invoice[]
  studentAttendance   StudentAttendance[]
  // Phase 2 relations
  homeworkSubmissions HomeworkSubmission[]
  certificates        Certificate[]
  canteenWallet       CanteenWallet?
  vehicleAssignment   StudentVehicle?
  refunds             RefundRequest[]
  parentMessages      ParentMessage[]
  appointments        Appointment[]
  remarks             StudentRemark[]
  scores              StudentScore[]
  loginDeliveries     AdmissionLoginDelivery[]
}

model AdmissionLoginDelivery {
  id                String                     @id @default(uuid())
  tenantId          String
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recipientUserId   String
  recipientUser     User                       @relation("AdmissionLoginRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipient         AdmissionLoginRecipient
  channel           String                     @default("SMS")
  provider          String                     @default("AAKASH")
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  failureReason     String?
  attemptCount      Int                        @default(0)
  encryptedPayload  String?
  leaseToken        String?
  leaseUntil        DateTime?
  nextAttemptAt     DateTime                   @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([studentId, recipient])
  @@index([status, nextAttemptAt, leaseUntil])
  @@index([tenantId, status, updatedAt])
}

model ParentMessage {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  senderId    String
  sender      User      @relation("ParentMessageSender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User      @relation("ParentMessageReceiver", fields: [receiverId], references: [id])
  messageText String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([tenantId, studentId, senderId, receiverId, createdAt])
}

model Broadcast {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  authorId      String
  author        User     @relation("BroadcastAuthor", fields: [authorId], references: [id])
  title         String
  message       String
  audienceRoles Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
}

model SocialMediaPost {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  content        String
  mediaUrls      Json?
  status         SocialPostStatus   @default(DRAFT)
  approvedAt     DateTime?
  approvedById   String?
  scheduledFor   DateTime?
  scheduledById  String?
  attemptCount   Int                @default(0)
  lastAttemptAt  DateTime?
  providerPostId String?
  lastError      String?
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attempts       SocialPublishAttempt[]

  @@index([tenantId, status, scheduledFor])
}

model SocialPublishAttempt {
  id             String               @id @default(uuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postId         String
  post           SocialMediaPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  outcome        SocialPublishOutcome
  detail         String
  providerPostId String?
  attemptedAt    DateTime             @default(now())

  @@index([tenantId, postId, attemptedAt])
}

model Appointment {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  studentId             String
  student               Student           @relation(fields: [studentId], references: [id])
  requestedById         String
  requestedBy           User              @relation("AppointmentRequester", fields: [requestedById], references: [id])
  teacherId             String
  teacher               User              @relation("AppointmentTeacher", fields: [teacherId], references: [id])
  scheduledTime         DateTime
  alternativeTime       DateTime?
  originalAppointmentId String?
  status                AppointmentStatus @default(REQUESTED)
  isGroup               Boolean           @default(false)
  participantIds        Json?
  participantApprovals  Json?
  remarks               String?
  responseRemarks       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([tenantId, studentId, scheduledTime])
  @@index([teacherId, status, scheduledTime])
  @@index([originalAppointmentId])
}

model StudentRemark {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id])
  authorId      String
  author        User              @relation("StudentRemarkAuthor", fields: [authorId], references: [id])
  subject       String
  message       String
  signal        PerformanceSignal @default(STABLE)
  parentVisible Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, studentId, parentVisible, createdAt])
}

model StudentScore {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id])
  recordedBy     String
  recorder       User      @relation("StudentScoreRecorder", fields: [recordedBy], references: [id])
  resultDefinitionId String?
  resultDefinition   ResultDefinition? @relation(fields: [resultDefinitionId], references: [id], onDelete: SetNull)
  subject        String
  assessment     String
  score          Decimal   @db.Decimal(8, 2)
  maximum        Decimal   @db.Decimal(8, 2)
  passMarks      Decimal?  @db.Decimal(8, 2)
  percentile     Decimal?  @db.Decimal(8, 2)
  resultSheetUrl String?
  publishedAt    DateTime?
  testDate       DateTime
  createdAt      DateTime  @default(now())

  @@index([tenantId, studentId, subject, testDate])
  @@unique([resultDefinitionId, studentId])
}

// 8. Parent / Guardian Records
model Parent {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentParents StudentParent[]
}

// 9. Student-Parent Junction
model StudentParent {
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  parentId  String
  parent    Parent  @relation(fields: [parentId], references: [id])

  @@id([studentId, parentId])
}

// 10. Course Definition
model Course {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  gradeId         String?
  grade           Grade?          @relation(fields: [gradeId], references: [id])
  name            String
  description     String?
  type            CourseType      @default(REGULAR)
  isExtraActivity Boolean         @default(false)
  feeStructure    Json // Flat monthly, installments, or hourly
  isTaxExempt     Boolean         @default(false) // Supports tax-exempt courses (Nepalese VAT)
  taxPercentage   Decimal         @default(13.00) @db.Decimal(5, 2) // Defaults to standard 13% VAT
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  classes         Class[]
  enrollments     Enrollment[]
  refunds         RefundRequest[]
}

// 11. Class / Timetable Instance
model Class {
  academicEvents    AcademicEvent[]
  id                String              @id @default(uuid())
  courseId          String
  course            Course              @relation(fields: [courseId], references: [id])
  branchId          String
  branch            Branch              @relation(fields: [branchId], references: [id])
  teacherId         String? // Assigned teacher (drives session generation)
  assignedTeacher   User?               @relation("AssignedClasses", fields: [teacherId], references: [id])
  name              String
  schedule          Json // Timetable days & time slots
  academicYear      String              @default("")
  effectiveFrom     DateTime?           @db.Date
  effectiveUntil    DateTime?           @db.Date
  archivedAt        DateTime?
  archivedBy        String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  enrollments       Enrollment[]
  sessions          TeacherSession[]
  studentAttendance StudentAttendance[]
  // Phase 2 relations
  homework          Homework[]
  syllabi           Syllabus[]
  resultDefinitions ResultDefinition[]
  timetableVersions TimetableVersion[]

  @@index([branchId, archivedAt, academicYear, effectiveFrom, effectiveUntil])
}

model TimetableVersion {
  id            String   @id @default(uuid())
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  version       Int
  academicYear  String
  effectiveFrom DateTime? @db.Date
  effectiveUntil DateTime? @db.Date
  teacherId     String?
  name          String
  schedule      Json
  changedBy     String
  createdAt     DateTime @default(now())

  @@unique([classId, version])
  @@index([classId, createdAt])
}

// 12. Student Enrollment
model Enrollment {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  status        String // ACTIVE, COMPLETED, DROPPED, BLOCKED
  admissionDate DateTime
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId, validUntil])
}

// 13. Teacher GPS Stamps
model TeacherAttendance {
  id          String   @id @default(uuid())
  userId      String // Teacher's User ID
  user        User     @relation(fields: [userId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  stampType   String // IN, OUT, AUTO_OUT, RE_IN
  latitude    Float
  longitude   Float
  gpsAccuracy Float
  timestamp   DateTime @default(now())
}

// 14. Teacher Session Log
model TeacherSession {
  id                   String              @id @default(uuid())
  teacherId            String
  teacher              User                @relation(fields: [teacherId], references: [id])
  classId              String
  class                Class               @relation(fields: [classId], references: [id])
  date                 DateTime            @db.Date
  status               SessionStatus       @default(PRESENT_UPDATE_PENDING)
  checkInTime          DateTime?
  checkOutTime         DateTime?
  totalMinutes         Int                 @default(0)
  dailyUpdateSubmitted Boolean             @default(false)
  updateContent        String? // Mandatory lesson summary text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  studentAttendance    StudentAttendance[]

  @@index([teacherId, classId, date])
}

// 15. Student Attendance
model StudentAttendance {
  id        String                  @id @default(uuid())
  studentId String
  student   Student                 @relation(fields: [studentId], references: [id])
  classId   String
  class     Class                   @relation(fields: [classId], references: [id])
  sessionId String
  session   TeacherSession          @relation(fields: [sessionId], references: [id])
  date      DateTime                @db.Date
  status    StudentAttendanceStatus @default(PRESENT)
  markedBy  String // Teacher's user ID who marked it
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

// 16. Fees and Invoicing
model Invoice {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id])
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id])
  amount            Decimal          @db.Decimal(12, 2)
  discount          Decimal          @default(0.00) @db.Decimal(12, 2)
  fine              Decimal          @default(0.00) @db.Decimal(12, 2)
  netPayable        Decimal          @db.Decimal(12, 2)
  billingCycleStart DateTime
  billingCycleEnd   DateTime
  dueDate           DateTime
  status            InvoiceStatus    @default(UNPAID)
  invoiceType       InvoiceType      @default(TUITION)
  panNumberSnapshot String           @default("")
  vatRateSnapshot   Decimal          @default(0.00) @db.Decimal(5, 2)
  lineItemsSnapshot Json?
  nepalPayQrCode    String? // Storage for Nepal Pay QR string/image reference
  transactionId     String?          @unique // External payment transaction reference
  paymentDate       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  paymentAttempts   PaymentAttempt[]

  // A student can receive only one recurring invoice of each type per BS cycle.
  @@unique([studentId, invoiceType, billingCycleStart])
  @@index([tenantId, branchId, dueDate])
}

model PaymentAttempt {
  id                 String               @id @default(uuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  invoiceId          String
  invoice            Invoice              @relation(fields: [invoiceId], references: [id])
  branchId           String
  branch             Branch               @relation(fields: [branchId], references: [id])
  provider           PaymentProvider
  status             PaymentAttemptStatus @default(PENDING)
  txnId              String               @unique
  referenceId        String
  amountPaisa        BigInt
  gatewayStatus      String?
  gatewayMessage     String?
  validationAttempts Int                  @default(0)
  lastValidatedAt    DateTime?
  confirmedAt        DateTime?
  failedAt           DateTime?
  receiptProof       String?              @db.Text
  receiptMimeType    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewRemarks      String?
  createdBy          String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([invoiceId, provider, status])
  @@index([tenantId, branchId, createdAt])
}

// 17. Leaves
model Leave {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  branchId       String
  branch         Branch      @relation(fields: [branchId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  leaveType      LeaveType
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         LeaveStatus @default(PENDING)
  approvedBy     String? // Approver User ID
  remarks        String?
  policySnapshot Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// 18. Petty Cash Management
model PettyCash {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id])
  accountantId     String
  purpose          String
  amount           Decimal         @db.Decimal(12, 2)
  status           PettyCashStatus @default(PENDING)
  releasedAt       DateTime?
  receiptProofUrl  String?
  remainingBalance Decimal         @db.Decimal(12, 2)
  approvalChain    Json // Log of transitions: [{role, action, timestamp, comment}]
  requestItems     Json? // Itemized request: [{name, quantity, unitAmount, totalAmount}]
  policySnapshot   Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// 19. Infrastructure / Classroom Resource Logging
model ResourceLog {
  id             String            @id @default(uuid())
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  classroomId    String
  staffId        String // Submitting staff's user ID
  itemsCondition Json // { marker: "OK", duster: "MISSING", board: "DAMAGED" }
  actionRequired Boolean           @default(false)
  remarks        String?
  status         ResourceLogStatus @default(PENDING)
  assignedTaskId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// 20. Maintenance Tasks
model MaintenanceTask {
  id                     String    @id @default(uuid())
  branchId               String
  branch                 Branch    @relation(fields: [branchId], references: [id])
  assignedStaffId        String
  classroomId            String    @default("Facility")
  description            String
  status                 String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  completionTimestamp    DateTime?
  completedById          String?
  escalatedAt            DateTime?
  escalationDaysSnapshot Int       @default(3)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([assignedStaffId, status])
}

// ==========================================
// PHASE 2: ACADEMIC, OPERATIONS & INTELLIGENCE
// ==========================================

// 21. Homework Management
model Homework {
  id          String               @id @default(uuid())
  classId     String
  class       Class                @relation(fields: [classId], references: [id])
  subject     String
  title       String
  description String?
  contentUrl  String? // Link to homework PDF/document
  deadline    DateTime
  createdBy   String // Teacher's User ID
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id            String   @id @default(uuid())
  homeworkId    String
  homework      Homework @relation(fields: [homeworkId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  submissionUrl String? // Link to student's uploaded solution
  grade         String? // Marks/Grade awarded
  remarks       String?
  gradedBy      String? // Teacher's User ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([homeworkId, studentId])
}

enum ChapterProgressStatus {
  IN_PROGRESS
  COMPLETED
  LEFT
}

model Syllabus {
  id        String            @id @default(uuid())
  classId   String
  class     Class             @relation(fields: [classId], references: [id])
  subject   String
  createdBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  chapters  SyllabusChapter[]
  dailyLogs DailyLessonLog[]

  @@unique([classId, subject])
  @@index([createdBy, classId])
}

model SyllabusChapter {
  id         String                @id @default(uuid())
  syllabusId String
  syllabus   Syllabus              @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  title      String
  position   Int
  status     ChapterProgressStatus @default(LEFT)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  dailyLogs  DailyLessonLog[]
  topics     SyllabusTopic[]

  @@unique([syllabusId, position])
}

model SyllabusTopic {
  id        String                @id @default(uuid())
  chapterId String
  chapter   SyllabusChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  status    ChapterProgressStatus @default(LEFT)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  logs      TopicProgressLog[]

  @@unique([chapterId, position])
}

model TopicProgressLog {
  id        String                @id @default(uuid())
  topicId   String
  topic     SyllabusTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  teacherId String
  classId   String
  logDate   DateTime              @db.Date
  status    ChapterProgressStatus
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([topicId, logDate])
  @@index([classId, logDate])
}

model ResultDefinition {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy String
  title     String
  subject   String
  testDate  DateTime @db.Date
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scores    StudentScore[]

  @@index([tenantId, branchId, classId, isOpen])
}

model DailyLessonLog {
  id         String                @id @default(uuid())
  syllabusId String
  syllabus   Syllabus              @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  chapterId  String
  chapter    SyllabusChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacherId  String
  classId    String
  logDate    DateTime              @db.Date
  status     ChapterProgressStatus
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([chapterId, logDate])
  @@index([classId, logDate])
}

// 22. Academic & Event Calendar
enum EventType {
  HOLIDAY
  EXAM
  EVENT
  FEE_DUE
}

model AcademicEvent {
  audience    String    @default("STAFF")
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id], onDelete: Restrict)
  @@index([tenantId, branchId, classId])
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  branchId    String? // Null means tenant-wide (pushed to all branches)
  branch      Branch?   @relation(fields: [branchId], references: [id])
  title       String
  description String?
  eventType   EventType @default(EVENT)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Front-desk arrival record. This is intentionally separate from classroom attendance.
model ReceptionCheckIn {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  studentId     String
  checkedInById String
  checkInDate   DateTime @db.Date
  checkedInAt   DateTime @default(now())

  @@unique([branchId, studentId, checkInDate])
  @@index([tenantId, branchId, checkInDate])
}

// 24. Certificate Generation System
enum CertificateType {
  COMPLETION
  ACHIEVEMENT
  ATTENDANCE
  CUSTOM
}

model CertificateTemplate {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  name         String
  type         CertificateType @default(COMPLETION)
  layoutConfig Json // JSON: fonts, background, logos, text blocks
  status       String          @default("ACTIVE")
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  certificates Certificate[]
}

model Certificate {
  id            String              @id @default(uuid())
  certificateId String              @unique // Unique verification ID
  studentId     String
  student       Student             @relation(fields: [studentId], references: [id])
  templateId    String
  template      CertificateTemplate @relation(fields: [templateId], references: [id])
  branchId      String
  branch        Branch              @relation(fields: [branchId], references: [id])
  issuerId      String // Admin User ID who issued
  issuedDate    DateTime            @default(now())
  pdfUrl        String? // Optional cached private object reference
  snapshot      Json? // Immutable recipient, issuer, branch, template and award values
  status        String              @default("ACTIVE")
  revokedAt     DateTime?
  revokedBy     String?
  revocationReason String?
  createdAt     DateTime            @default(now())

  @@index([branchId, status, issuedDate])
}

// 25. Extended HR — Staff Documents
model StaffDocument {
  id            String      @id @default(uuid())
  staffRecordId String
  staffRecord   StaffRecord @relation(fields: [staffRecordId], references: [id])
  documentType  String // NID, CONTRACT, ACADEMIC, CERTIFICATION
  fileUrl       String
  expiryDate    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// 26. Staff Performance Scoring (Continuous)
model StaffPerformanceScore {
  id                   String      @id @default(uuid())
  staffRecordId        String      @unique
  staffRecord          StaffRecord @relation(fields: [staffRecordId], references: [id])
  overallScore         Float       @default(100.0) // 0-100 composite
  attendanceRate       Float       @default(100.0)
  classUpdateRate      Float       @default(100.0)
  studentFeedbackScore Float       @default(5.0) // 1-5 rating
  parentFeedbackScore  Float       @default(5.0) // 1-5 rating
  leaveComplianceRate  Float       @default(100.0)
  scoreHistory         Json? // [{date, score}] trend data
  updatedAt            DateTime    @updatedAt
}

// 27. Staff Exit Clearance
model ExitClearance {
  id                 String      @id @default(uuid())
  staffRecordId      String      @unique
  staffRecord        StaffRecord @relation(fields: [staffRecordId], references: [id])
  resignationDate    DateTime
  reason             String?
  noticePeriodDays   Int
  clearanceChecklist Json // [{item, cleared, signature}]
  finalSettlementNpr Decimal     @db.Decimal(12, 2)
  status             String      @default("PENDING") // PENDING, CLEARANCE_COMPLETED, SETTLED
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model FeeAccessOverride {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  studentId     String
  scope         String
  reason        String
  grantedById   String
  grantedByName String
  startsAt      DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([tenantId, branchId, studentId, createdAt])
}

// 28. Canteen Management
model CanteenWallet {
  id           String               @id @default(uuid())
  studentId    String               @unique
  student      Student              @relation(fields: [studentId], references: [id])
  balance      Decimal              @default(0.00) @db.Decimal(12, 2)
  pinHash      String?
  status       String               @default("ACTIVE") // ACTIVE, LOCKED
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions CanteenTransaction[]
}

model CanteenTransaction {
  id          String        @id @default(uuid())
  walletId    String
  wallet      CanteenWallet @relation(fields: [walletId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  type        String // CREDIT (Reload), DEBIT (Purchase)
  description String?
  referenceId String? // Nepal Pay transaction ID for reloads
  createdAt   DateTime      @default(now())
}

// 29. Vehicle Routing & Tracking
model VehicleRoute {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  routeName        String
  driverName       String
  driverPhone      String
  vehicleNumber    String?
  currentLatitude  Float?
  currentLongitude Float?
  lastUpdated      DateTime?
  updatedAt        DateTime         @updatedAt
  students         StudentVehicle[]
}

model StudentVehicle {
  studentId   String       @unique
  student     Student      @relation(fields: [studentId], references: [id])
  routeId     String
  route       VehicleRoute @relation(fields: [routeId], references: [id])
  pickupPoint String?
  createdAt   DateTime     @default(now())

  @@id([studentId, routeId])
}

// ==========================================
// PHASE 3: ERP & ADVANCED
// ==========================================

model Expense {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  category   String // RENT, UTILITIES, MAINTENANCE, SALARY, MARKETING, OTHER
  amount     Float
  purpose    String
  date       DateTime @default(now())
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum PayrollStatus {
  PENDING
  APPROVED_FOR_MANUAL_PAYMENT
  MANUALLY_PAID
}

model Payroll {
  id                   String      @id @default(uuid())
  tenantId             String
  tenant               Tenant      @relation(fields: [tenantId], references: [id])
  staffRecordId        String
  staffRecord          StaffRecord @relation(fields: [staffRecordId], references: [id])
  branchId             String
  branch               Branch      @relation(fields: [branchId], references: [id])
  month                Int
  year                 Int
  payslipNumber        String      @unique
  baseSalary           Decimal     @db.Decimal(12, 2)
  attendanceDeductions Decimal     @db.Decimal(12, 2)
  bonuses              Decimal     @db.Decimal(12, 2)
  netPayable           Decimal     @db.Decimal(12, 2)
  status               PayrollStatus @default(PENDING)
  calculationBreakdown Json
  adjustmentRemarks    String?
  calculatedBy         String?
  calculatedAt         DateTime    @default(now())
  approvedBy           String?
  approvedAt           DateTime?
  settlementReference  String?
  paymentEvidence      String?
  settlementDate       DateTime?
  reconciledBy         String?
  paymentDate          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([staffRecordId, month, year])
  @@index([tenantId, year, month, status])
  @@index([tenantId, branchId, year, month])
}

model RefundRequest {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  studentId           String
  student             Student   @relation(fields: [studentId], references: [id])
  courseId            String
  course              Course    @relation(fields: [courseId], references: [id])
  reason              String
  refundAmount        Float
  deductionAmount     Float
  status              String    @default("PENDING") // PENDING, APPROVED_FOR_MANUAL_REFUND, MANUALLY_REFUNDED, REJECTED
  approvedBy          String?
  approvedAt          DateTime?
  settlementReference String?
  settledAt           DateTime?
  settledBy           String?
  settlementRemarks   String?
  policySnapshot      Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model TenantPolicyVersion {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  version       Int
  config        Json
  effectiveFrom DateTime @default(now())
  changedBy     String
  createdAt     DateTime @default(now())

  @@unique([tenantId, version])
  @@index([tenantId, effectiveFrom])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// Better Auth's persistent, cross-instance request limiter.
model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Contains no credentials, email address, or raw IP address. It records only
// security-relevant failed authentication outcomes for operational monitoring.
model AuthSecurityEvent {
  id         String   @id @default(uuid())
  event      String
  sourceHash String
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
}

model VerificationCode {
  id         String    @id @default(uuid())
  identifier String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

// Additional monthly branch allowance; separate from actual cash expenses.
model PettyCashFunding {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  branchId String
  branch Branch @relation(fields: [branchId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  purpose String
  period String
  status String @default("PENDING")
  requestedBy String
  decidedBy String?
  remarks String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, branchId, period, status])
}

// Branch-specific payment settings (e.g., static QR code per location)
model BranchPaymentSettings {
  id                  String   @id @default(uuid())
  branchId            String   @unique
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  staticQrEnabled     Boolean  @default(false)
  staticQrImageUrl    String?
  accountName         String?
  accountNumber       String?
  bankName            String?
  instructions        String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([tenantId])
  @@index([branchId, tenantId])
}

model MediaObject {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    String
  ownerType   String
  ownerId     String
  objectKey   String    @unique
  mimeType    String
  byteSize    Int
  sha256      String
  width       Int?
  height      Int?
  status      String    @default("ACTIVE")
  createdBy   String
  createdAt   DateTime  @default(now())
  replacedAt  DateTime?
  deletedAt   DateTime?

  @@index([tenantId, category, ownerType, ownerId, status])
  @@index([tenantId, branchId, category])
}

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tms?schema=public"

# REQUIRED — the API refuses to start without it. Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:5173"

# Optional overrides for the bootstrap seed (npm run db:seed).
# Required only when PLATFORM_ADMIN_ENABLED=true. Store both values in a
# secret manager; they are never generated or printed by the seed script.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Platform provisioning. Keep disabled normally. For the one-time initial
# production handoff, set the acknowledgement to INITIAL_TENANT_BOOTSTRAP,
# provision and verify the Tenant Admin, then clear both values and restart.
PLATFORM_ADMIN_ENABLED="false"
PLATFORM_ADMIN_PRODUCTION_ACK=""

# SMS delivery. Keep MOCK for local development; set AAKASH only after adding
# an active API token in the Aakash SMS dashboard (API Service > Token).
SMS_PROVIDER="MOCK"
# Production: use AAKASH with a real token, or DISABLED to fail closed without
# claiming that simulated messages were delivered.
# AAKASH_SMS_AUTH_TOKEN=""
# HMAC secret used to verify payment gateway callbacks.
NEPALPAY_WEBHOOK_SECRET=""
# Long random key used to encrypt connected social-platform tokens at rest.

# connectIPS gateway checkout. Keep disabled until NCHL UAT credentials and
# static success/failure URLs have been registered.
CONNECTIPS_ENABLED="false"
CONNECTIPS_MERCHANT_ID=""
CONNECTIPS_APP_ID=""
CONNECTIPS_APP_NAME=""
CONNECTIPS_PFX_BASE64=""
CONNECTIPS_PFX_PASSWORD=""
CONNECTIPS_VALIDATE_PASSWORD=""
CONNECTIPS_GATEWAY_URL="https://uat.connectips.com/connectipswebgw/loginpage"
CONNECTIPS_VALIDATE_URL="https://uat.connectips.com/connectipswebws/api/creditor/validatetxn"
# Server-only scheduler batch size (1-100). Run the reconciliation command every five minutes after UAT is enabled.
CONNECTIPS_RECONCILIATION_LIMIT="50"

# Optional private Cloudflare R2 storage for uploaded manual-payment proofs.
# When incomplete, the API retains the current database data-URI fallback.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tms-private-media"
# AAKASH_SMS_AUTH_TOKEN=""
# SMS_TEST_TO="98xxxxxxxx,98yyyyyyyy"
# SMS_FIXTURE_TEST_MODE="false"
# SMS_FIXTURE_PHONE_NUMBERS="98xxxxxxxx,98yyyyyyyy,98zzzzzzzz"
